{
  "github": {
    "mcp_id": "github",
    "display_name": "GitHub Official MCP",
    "description": "Official GitHub MCP Server. Provides seamless integration with GitHub APIs, enabling advanced automation and interaction capabilities for managing repositories, issues, pull requests, and more.",
    "capabilities": [
      "code_hosting.read_issues",
      "code_hosting.read_repos",
      "code_hosting.create_issue",
      "code_hosting.manage_pr",
      "code_hosting.search_code"
    ],
    "env_vars": ["GITHUB_TOKEN"],
    "docker_image": "mcp/github",
    "example_tools": [
      "list_issues",
      "get_repo",
      "create_issue",
      "search_repositories",
      "get_pull_request"
    ],
    "docs_url": "https://hub.docker.com/mcp/server/github"
  },
  "brave-search": {
    "mcp_id": "brave-search",
    "display_name": "Brave Search MCP",
    "description": "Search the Web for pages, images, news, videos, and more using the Brave Search API. Provides privacy-focused web search capabilities.",
    "capabilities": [
      "web_search",
      "web_discovery",
      "search.images",
      "search.news"
    ],
    "env_vars": ["BRAVE_API_KEY"],
    "docker_image": "mcp/brave",
    "example_tools": [
      "search",
      "search_images",
      "search_news",
      "get_webpage_summary"
    ],
    "docs_url": "https://hub.docker.com/mcp/server/brave-search"
  },
