# E2B 部署环境变量示例
# 复制此文件为 .env.e2b 并填入真实值

# E2B API Key (必需) - 从 https://e2b.dev/dashboard 获取
E2B_API_KEY=e2b_xxx

# Groq API Key (必需) - 从 https://console.groq.com/ 获取
GROQ_API_KEY=gsk_xxx

# GitHub Token (可选，用于真实 demo) - 从 https://github.com/settings/tokens 获取
GITHUB_TOKEN=ghp_xxx

# Brave Search API Key (可选) - 从 https://brave.com/search/api/ 获取
BRAVE_API_KEY=BSA_xxx

# API Server 配置
API_HOST=0.0.0.0
API_PORT=8000

